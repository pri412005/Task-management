
# Dependencies (Never commit node_modules)
node_modules/
jspm_packages/
bower_components/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (Next.js / Node.js crash dumps)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul or nyc
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string build cache
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache

# REPL history
.node_repl_history

# Output directory from TypeScript compiler
*.tsbuildinfo

# Local environment files (Contains sensitive API keys and secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Next.js build output
.next/
out/

# Nuxt.js build output
.nuxt/
dist/

# Serverless framework folders
.serverless/

# OS-specific files (Optional but highly recommended)
.DS_Store
Thumbs.db